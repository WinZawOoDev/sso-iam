# Copy to .env.local and fill in. Never commit real values.

# Local email/password and email-verification session signing key (min 32 chars).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET=

# Keycloak OIDC client. Register this callback URL in the Keycloak client:
# http://localhost:3000/api/auth/callback/keycloak
# AUTH_KEYCLOAK_ISSUER must include the realm, e.g. https://keycloak.example.com/realms/my-realm
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=
