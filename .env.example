# Copy to .env.local and fill in. Never commit real values.

# Session signing key (min 32 chars). Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public base URL of this app. Used to build OAuth callback URLs.
# Set this in production so callbacks don't depend on the request Host header.
APP_URL=http://localhost:3000

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app (https://github.com/settings/developers)
# Authorization callback URL: {APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Active Directory over LDAP. Use ldaps:// in production.
# LDAP_BIND_DN is a read-only service account used to look users up.
LDAP_URL=ldaps://dc.example.com:636
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-sso,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=
